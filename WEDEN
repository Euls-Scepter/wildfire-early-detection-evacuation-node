// =====================================================
// READ SENSORS
// =====================================================

void readSensors() {

  // ===================================================
  // MQ-2
  // ===================================================

  int mq2Value =
    readAverageRaw(
      MQ2_PIN);


  uint32_t mq2PinMv =
    readAverageMilliVolts(
      MQ2_PIN);


  float mq2PinVoltage =
    mq2PinMv /
    1000.0f;


  float mq2Voltage =
    mq2PinVoltage *
    (
      (
        MQ2_DIVIDER_TOP_OHMS +
        MQ2_DIVIDER_BOTTOM_OHMS
      )
      /
      MQ2_DIVIDER_BOTTOM_OHMS
    );


  // ===================================================
  // TMP36
  // ===================================================

  float temperature =
    readTMP36();


  // ===================================================
  // CONDITIONS
  // ===================================================

  bool mq2High =
    mq2Value >= MQ2_THRESHOLD;


  bool tempHigh =
    temperature >= TEMP_THRESHOLD;


  const char* status;


  if (
    !mq2High &&
    !tempHigh) {

    status = "SAFE";
  }

  else if (
    (mq2High && !tempHigh) ||
    (!mq2High && tempHigh)) {

    status = "WARNING";
  }

  else {

    status = "VERIFYING";
  }


  // ===================================================
  // LED
  // ===================================================

  setStatusLEDs(
    mq2High,
    tempHigh);


  // ===================================================
  // SERIAL
  // ===================================================

  Serial.println();

  Serial.println(
    "--------------------------------");


  Serial.print(
    "MQ-2: ");

  Serial.print(
    mq2Value);


  Serial.print(
    " | MQ2: ");

  Serial.print(
    mq2High ?
    "HIGH" :
    "LOW");


  Serial.print(
    " | TMP36: ");

  Serial.print(
    temperature,
    1);


  Serial.print(
    " C | TEMP: ");


  Serial.print(
    tempHigh ?
    "HIGH" :
    "LOW");


  Serial.print(
    " | STATUS: ");


  Serial.println(
    status);


  Serial.print(
    "MQ2 PIN: ");

  Serial.print(
    mq2PinVoltage,
    3);


  Serial.print(
    " V | MQ2 AO: ");


  Serial.print(
    mq2Voltage,
    3);


  Serial.println(
    " V");


  // ===================================================
  // SUPABASE TELEMETRY
  // ===================================================

  sendToSupabase(
    mq2Value,
    temperature,
    mq2High,
    tempHigh,
    status);


  // ===================================================
  // BOTH HIGH
  // ===================================================

  if (
    mq2High &&
    tempHigh) {

    fireConfirmationCount++;


    Serial.print(
      "BOTH HIGH - CONFIRMATION ");


    Serial.print(
      fireConfirmationCount);


    Serial.print(
      "/");


    Serial.println(
      REQUIRED_FIRE_CONFIRMATIONS);


    updateLCD(
      mq2Value,
      temperature,
      "VERIFYING");


    // =================================================
    // FIRE CONFIRMATION
    // =================================================

    if (
      fireConfirmationCount >=
      REQUIRED_FIRE_CONFIRMATIONS) {

      Serial.println();

      Serial.println(
        "################################");

      Serial.println(
        "FIRE CONDITION CONFIRMED");

      Serial.println(
        "MQ-2 HIGH + TMP36 HIGH");

      Serial.println(
        "3 CONSECUTIVE READINGS");

      Serial.println(
        "################################");


      digitalWrite(
        GREEN_LED_PIN,
        LOW);

      digitalWrite(
        YELLOW_LED_PIN,
        HIGH);

      digitalWrite(
        RED_LED_PIN,
        LOW);


      if (!alarmRunning) {

        bool cooldownFinished =
          !alarmCooldownActive ||
          millis() - lastAlarmTime >=
          ALARM_COOLDOWN_MS;


        if (cooldownFinished) {

          alarmRunning = true;


          // =========================================
          // AI VERIFICATION
          // =========================================

          AIResult result =
            verifyCamera();


          // Cooldown only for valid AI result

          if (
            result == AI_FIRE ||
            result == AI_NO_FIRE) {

            alarmCooldownActive = true;

            lastAlarmTime =
              millis();
          }


          // =========================================
          // AI FIRE
          // =========================================

          if (
            result == AI_FIRE) {

            Serial.println();

            Serial.println(
              "AI RESULT: FIRE");

            Serial.println(
              "RED LED: BLINKING");

            Serial.println(
              "AI CONFIRMED FIRE");


            digitalWrite(
              GREEN_LED_PIN,
              LOW);

            digitalWrite(
              YELLOW_LED_PIN,
              LOW);


            fireLedBlinking =
              true;

            redLedState =
              true;

            lastRedBlink =
              millis();


            digitalWrite(
              RED_LED_PIN,
              HIGH);


            startWildfireAlarm(
              mq2Value,
              temperature);
          }


          // =========================================
          // AI NO FIRE
          // =========================================

          else if (
            result == AI_NO_FIRE) {

            fireLedBlinking =
              false;

            redLedState =
              false;


            digitalWrite(
              RED_LED_PIN,
              LOW);


            digitalWrite(
              GREEN_LED_PIN,
              LOW);

            digitalWrite(
              YELLOW_LED_PIN,
              HIGH);


            Serial.println(
              "AI says NO FIRE.");

            Serial.println(
              "No SMS sent.");

            Serial.println(
              "No call made.");


            sendAlertToSupabase(
              "NO_FIRE",
              mq2Value,
              temperature,
              false,
              false);


            lcd.clear();

            lcd.setCursor(
              0,
              0);

            lcd.print(
              "AI: NO FIRE");

            lcd.setCursor(
              0,
              1);

            lcd.print(
              "Monitoring...");


            delay(2000);
          }


          // =========================================
          // AI ERROR
          // =========================================

          else {

            Serial.println();

            Serial.println(
              "AI RESULT: ERROR");


            fireLedBlinking =
              false;

            redLedState =
              false;


            digitalWrite(
              RED_LED_PIN,
              LOW);


            digitalWrite(
              GREEN_LED_PIN,
              LOW);

            digitalWrite(
              YELLOW_LED_PIN,
              HIGH);


            Serial.println(
              "AI verification failed.");

            Serial.println(
              "NO SMS SENT.");

            Serial.println(
              "NO CALL MADE.");


            sendAlertToSupabase(
              "ERROR",
              mq2Value,
              temperature,
              false,
              false);


            lcd.clear();

            lcd.setCursor(
              0,
              0);

            lcd.print(
              "AI ERROR");

            lcd.setCursor(
              0,
              1);

            lcd.print(
              "Retry Later");


            delay(2000);
          }


          alarmRunning =
            false;
        }

        else {

          unsigned long elapsed =
            millis() -
            lastAlarmTime;


          unsigned long remaining =
            (
              ALARM_COOLDOWN_MS -
              elapsed
            ) /
            1000;


          Serial.println();

          Serial.println(
            "ALARM COOLDOWN ACTIVE");


          Serial.print(
            "Remaining: ");


          Serial.print(
            remaining);


          Serial.println(
            " seconds");
        }
      }


      fireConfirmationCount =
        0;
    }
  }


  // ===================================================
  // MQ2 HIGH ONLY
  // ===================================================

  else if (mq2High) {

    fireConfirmationCount =
      0;


    Serial.println(
      "SMOKE HIGH - WARNING");


    fireLedBlinking =
      false;

    redLedState =
      false;


    digitalWrite(
      GREEN_LED_PIN,
      LOW);

    digitalWrite(
      YELLOW_LED_PIN,
      HIGH);

    digitalWrite(
      RED_LED_PIN,
      LOW);


    updateLCD(
      mq2Value,
      temperature,
      "WARNING");
  }


  // ===================================================
  // TMP36 HIGH ONLY
  // ===================================================

  else if (tempHigh) {

    fireConfirmationCount =
      0;


    Serial.println(
      "TEMP HIGH - WARNING");


    fireLedBlinking =
      false;

    redLedState =
      false;


    digitalWrite(
      GREEN_LED_PIN,
      LOW);

    digitalWrite(
      YELLOW_LED_PIN,
      HIGH);

    digitalWrite(
      RED_LED_PIN,
      LOW);


    updateLCD(
      mq2Value,
      temperature,
      "WARNING");
  }


  // ===================================================
  // BOTH NORMAL
  // ===================================================

  else {

    fireConfirmationCount =
      0;


    Serial.println(
      "SAFE");


    fireLedBlinking =
      false;

    redLedState =
      false;


    digitalWrite(
      GREEN_LED_PIN,
      HIGH);

    digitalWrite(
      YELLOW_LED_PIN,
      LOW);

    digitalWrite(
      RED_LED_PIN,
      LOW);


    updateLCD(
      mq2Value,
      temperature,
      "SAFE");
  }
}


// =====================================================
// SUPABASE GENERIC POST
// =====================================================

bool supabasePost(
  const char* table,
  const String& json) {

  if (
    WiFi.status() !=
    WL_CONNECTED) {

    Serial.println(
      "SUPABASE: WiFi disconnected.");

    return false;
  }


  WiFiClientSecure client;

  client.setInsecure();


  HTTPClient http;


  String url =
    String(SUPABASE_URL) +
    "/rest/v1/" +
    table;


  Serial.println();

  Serial.print(
    "SUPABASE [");

  Serial.print(
    table);

  Serial.println(
    "]: Sending...");


  if (
    !http.begin(
      client,
      url)) {

    Serial.println(
      "SUPABASE: HTTP begin FAILED.");

    return false;
  }


  http.addHeader(
    "apikey",
    SUPABASE_ANON_KEY);


  http.addHeader(
    "Authorization",
    String("Bearer ") +
    SUPABASE_ANON_KEY);


  http.addHeader(
    "Content-Type",
    "application/json");


  http.addHeader(
    "Prefer",
    "return=minimal");


  Serial.print(
    "SUPABASE JSON: ");

  Serial.println(
    json);


  int httpCode =
    http.POST(
      json);


  Serial.print(
    "SUPABASE HTTP CODE: ");

  Serial.println(
    httpCode);


  if (
    httpCode > 0) {

    String response =
      http.getString();


    if (
      response.length() > 0) {

      Serial.print(
        "SUPABASE RESPONSE: ");

      Serial.println(
        response);
    }
  }


  http.end();


  if (
    httpCode >= 200 &&
    httpCode < 300) {

    Serial.println(
      "SUPABASE: INSERT SUCCESS");

    return true;
  }


  Serial.println(
    "SUPABASE: INSERT FAILED");

  return false;
}


