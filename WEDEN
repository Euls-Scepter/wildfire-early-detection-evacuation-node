// =====================================================
// DELAY WITH FIRE LED BLINK
// =====================================================

void delayWithFireBlink(
  unsigned long duration) {

  unsigned long startTime =
    millis();

  while (
    millis() - startTime < duration) {

    updateFireLEDBlink();

    delay(10);
  }
}


// =====================================================
// LED STATUS
// =====================================================

void setStatusLEDs(
  bool mq2High,
  bool tempHigh) {

  // SAFE

  if (!mq2High && !tempHigh) {

    digitalWrite(
      GREEN_LED_PIN,
      HIGH);

    digitalWrite(
      YELLOW_LED_PIN,
      LOW);

    digitalWrite(
      RED_LED_PIN,
      LOW);

    return;
  }


  // WARNING

  if (
    (mq2High && !tempHigh) ||
    (!mq2High && tempHigh)) {

    digitalWrite(
      GREEN_LED_PIN,
      LOW);

    digitalWrite(
      YELLOW_LED_PIN,
      HIGH);

    digitalWrite(
      RED_LED_PIN,
      LOW);

    return;
  }


  // BOTH HIGH / VERIFYING

  if (mq2High && tempHigh) {

    digitalWrite(
      GREEN_LED_PIN,
      LOW);

    digitalWrite(
      YELLOW_LED_PIN,
      HIGH);

    digitalWrite(
      RED_LED_PIN,
      LOW);

    return;
  }
}


// =====================================================
// FIRE LED BLINK
// =====================================================

void updateFireLEDBlink() {

  if (!fireLedBlinking) {

    digitalWrite(
      RED_LED_PIN,
      LOW);

    redLedState = false;

    return;
  }


  if (
    millis() - lastRedBlink >=
    RED_BLINK_INTERVAL) {

    lastRedBlink = millis();

    redLedState =
      !redLedState;

    digitalWrite(
      RED_LED_PIN,
      redLedState ?
      HIGH :
      LOW);
  }
}


