// =====================================================
// ADC RAW
// =====================================================

uint32_t readAverageRaw(
  uint8_t pin) {

  uint64_t total = 0;


  for (
    int i = 0;
    i < ADC_SAMPLES;
    i++) {

    total +=
      analogRead(pin);

    delayMicroseconds(500);
  }


  return (
    uint32_t)(
      total /
      ADC_SAMPLES
    );
}


// =====================================================
// ADC MILLIVOLT
// =====================================================

uint32_t readAverageMilliVolts(
  uint8_t pin) {

  uint64_t total = 0;


  for (
    int i = 0;
    i < ADC_SAMPLES;
    i++) {

    total +=
      analogReadMilliVolts(
        pin);

    delayMicroseconds(500);
  }


  return (
    uint32_t)(
      total /
      ADC_SAMPLES
    );
}


// =====================================================
// TMP36
// =====================================================

float readTMP36() {

  uint32_t totalRaw = 0;

  uint64_t totalMv = 0;


  for (
    int i = 0;
    i < TMP36_SAMPLES;
    i++) {

    totalRaw +=
      analogRead(
        TMP36_PIN);


    totalMv +=
      analogReadMilliVolts(
        TMP36_PIN);


    delayMicroseconds(500);
  }


  uint32_t raw =
    totalRaw /
    TMP36_SAMPLES;


  float voltageMv =
    (
      float
    )(
      totalMv /
      TMP36_SAMPLES
    );


  float temperature =
    (
      voltageMv -
      500.0f
    ) /
    10.0f;


  temperature +=
    TMP36_OFFSET_C;


  Serial.print(
    "TMP36 RAW: ");

  Serial.print(
    raw);


  Serial.print(
    " | VOLTAGE: ");

  Serial.print(
    voltageMv,
    0);


  Serial.print(
    " mV | TEMP: ");

  Serial.print(
    temperature,
    1);


  Serial.println(
    " C");


  return temperature;
}


