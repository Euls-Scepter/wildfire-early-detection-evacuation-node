// =====================================================
// CAMERA + AI VERIFICATION
// =====================================================

AIResult verifyCamera() {

  Serial.println();

  Serial.println(
    "================================");

  Serial.println(
    "       CAMERA AI VERIFICATION");

  Serial.println(
    "================================");


  // ===================================================
  // WIFI
  // ===================================================

  if (
    WiFi.status() !=
    WL_CONNECTED) {

    Serial.println(
      "[AI] WiFi disconnected.");

    Serial.println(
      "[AI] Reconnecting...");


    connectWiFi();


    if (
      WiFi.status() !=
      WL_CONNECTED) {

      Serial.println(
        "[AI ERROR] WiFi reconnect FAILED.");

      return AI_ERROR;
    }
  }


  Serial.println(
    "[AI] WiFi connection OK.");


  Serial.print(
    "[AI] Main ESP32 IP: ");

  Serial.println(
    WiFi.localIP());


  // ===================================================
  // NETWORK TEST CAMERA
  // ===================================================

  if (
    !testCameraConnection()) {

    Serial.println(
      "[AI ERROR] ESP32-CAM is unreachable.");

    Serial.println(
      "[AI ERROR] Check CAMERA_IP.");

    return AI_ERROR;
  }


  // ===================================================
  // NETWORK TEST AI SERVER
  // ===================================================

  if (
    !testAIServerConnection()) {

    Serial.println(
      "[AI ERROR] Python AI server is unreachable.");

    Serial.println(
      "[AI ERROR] Check laptop IP / Flask server.");

    return AI_ERROR;
  }


  // ===================================================
  // CAMERA CAPTURE RETRIES
  // ===================================================

  const int MAX_CAMERA_ATTEMPTS = 3;

  uint8_t* imageBuffer = nullptr;

  size_t totalRead = 0;


  for (
    int cameraAttempt = 1;
    cameraAttempt <= MAX_CAMERA_ATTEMPTS;
    cameraAttempt++) {

    Serial.println();

    Serial.println(
      "--------------------------------");


    Serial.print(
      "[CAMERA] Capture attempt ");

    Serial.print(
      cameraAttempt);

    Serial.print(
      "/");

    Serial.println(
      MAX_CAMERA_ATTEMPTS);


    Serial.print(
      "[CAMERA] URL: ");

    Serial.println(
      CAMERA_URL);


    HTTPClient cameraHttp;

    WiFiClient cameraClient;


    cameraHttp.setConnectTimeout(
      10000);

    cameraHttp.setTimeout(
      20000);


    if (
      !cameraHttp.begin(
        cameraClient,
        CAMERA_URL)) {

      Serial.println(
        "[CAMERA ERROR] HTTP begin FAILED.");

      if (
        cameraAttempt <
        MAX_CAMERA_ATTEMPTS) {

        delay(1000);

        continue;
      }

      return AI_ERROR;
    }


    int cameraCode =
      cameraHttp.GET();


    Serial.print(
      "[CAMERA] HTTP CODE: ");

    Serial.println(
      cameraCode);


    if (
      cameraCode !=
      HTTP_CODE_OK) {

      Serial.print(
        "[CAMERA ERROR] HTTP error: ");

      Serial.println(
        cameraCode);


      cameraHttp.end();


      if (
        cameraAttempt <
        MAX_CAMERA_ATTEMPTS) {

        Serial.println(
          "[CAMERA] Retrying...");

        delay(1000);

        continue;
      }


      return AI_ERROR;
    }


    int imageSize =
      cameraHttp.getSize();


    Serial.print(
      "[CAMERA] Content-Length: ");

    Serial.println(
      imageSize);


    // =================================================
    // MAX JPEG SIZE
    // =================================================

    const size_t MAX_IMAGE_SIZE =
      300000;


    // =================================================
    // NORMAL CONTENT-LENGTH
    // =================================================

    if (
      imageSize > 0) {

      if (
        imageSize >
        (int)MAX_IMAGE_SIZE) {

        Serial.println(
          "[CAMERA ERROR] Image too large.");

        cameraHttp.end();


        if (
          cameraAttempt <
          MAX_CAMERA_ATTEMPTS) {

          delay(1000);

          continue;
        }


        return AI_ERROR;
      }


      imageBuffer =
        (uint8_t*)malloc(
          imageSize);


      if (
        imageBuffer == nullptr) {

        Serial.println(
          "[CAMERA ERROR] Not enough RAM.");

        cameraHttp.end();

        return AI_ERROR;
      }


      WiFiClient* cameraStream =
        cameraHttp.getStreamPtr();


      totalRead = 0;


      unsigned long imageStart =
        millis();


      while (
        totalRead <
        (size_t)imageSize &&
        millis() -
        imageStart <
        20000) {

        size_t availableBytes =
          cameraStream->available();


        if (
          availableBytes > 0) {

          size_t remaining =
            imageSize -
            totalRead;


          size_t toRead =
            availableBytes;


          if (
            toRead >
            remaining) {

            toRead =
              remaining;
          }


          if (
            toRead >
            4096) {

            toRead =
              4096;
          }


          int bytesRead =
            cameraStream->readBytes(
              imageBuffer +
              totalRead,
              toRead);


          if (
            bytesRead > 0) {

            totalRead +=
              bytesRead;
          }
        }

        else {

          delay(2);

          yield();
        }
      }


      cameraHttp.end();


      if (
        totalRead ==
        (size_t)imageSize) {

        Serial.print(
          "[CAMERA] Image downloaded: ");

        Serial.print(
          totalRead);

        Serial.println(
          " bytes");


        break;
      }


      Serial.print(
        "[CAMERA ERROR] Incomplete image: ");

      Serial.print(
        totalRead);

      Serial.print(
        " / ");

      Serial.print(
        imageSize);

      Serial.println(
        " bytes");


      free(
        imageBuffer);

      imageBuffer =
        nullptr;


      if (
        cameraAttempt <
        MAX_CAMERA_ATTEMPTS) {

        Serial.println(
          "[CAMERA] Retrying capture...");

        delay(1000);

        continue;
      }


      return AI_ERROR;
    }


    // =================================================
    // UNKNOWN CONTENT-LENGTH
    // =================================================

    Serial.println(
      "[CAMERA] Content-Length unavailable.");

    Serial.println(
      "[CAMERA] Using dynamic JPEG buffer.");


    const size_t INITIAL_BUFFER_SIZE =
      65536;


    imageBuffer =
      (uint8_t*)malloc(
        INITIAL_BUFFER_SIZE);


    if (
      imageBuffer == nullptr) {

      Serial.println(
        "[CAMERA ERROR] Initial buffer allocation failed.");

      cameraHttp.end();

      return AI_ERROR;
    }


    size_t bufferCapacity =
      INITIAL_BUFFER_SIZE;


    totalRead = 0;


    WiFiClient* cameraStream =
      cameraHttp.getStreamPtr();


    unsigned long imageStart =
      millis();


    while (
      millis() -
      imageStart <
      20000) {

      while (
        cameraStream->available()) {

        uint8_t tempBuffer[2048];


        int bytesRead =
          cameraStream->read(
            tempBuffer,
            sizeof(tempBuffer));


        if (
          bytesRead <= 0) {

          break;
        }


        // ---------------------------------------------
        // Need more RAM?
        // ---------------------------------------------

        if (
          totalRead +
          bytesRead >
          bufferCapacity) {

          size_t newCapacity =
            bufferCapacity * 2;


          if (
            newCapacity >
            MAX_IMAGE_SIZE) {

            newCapacity =
              MAX_IMAGE_SIZE;
          }


          if (
            totalRead +
            bytesRead >
            newCapacity) {

            Serial.println(
              "[CAMERA ERROR] JPEG exceeds maximum size.");

            free(
              imageBuffer);

            imageBuffer =
              nullptr;

            cameraHttp.end();

            return AI_ERROR;
          }


          uint8_t* newBuffer =
            (uint8_t*)realloc(
              imageBuffer,
              newCapacity);


          if (
            newBuffer == nullptr) {

            Serial.println(
              "[CAMERA ERROR] Buffer expansion failed.");

            free(
              imageBuffer);

            imageBuffer =
              nullptr;

            cameraHttp.end();

            return AI_ERROR;
          }


          imageBuffer =
            newBuffer;

          bufferCapacity =
            newCapacity;
        }


        memcpy(
          imageBuffer +
          totalRead,
          tempBuffer,
          bytesRead);


        totalRead +=
          bytesRead;
      }


      if (
        !cameraStream->connected() &&
        !cameraStream->available()) {

        break;
      }


      delay(5);

      yield();
    }


    cameraHttp.end();


    if (
      totalRead == 0) {

      Serial.println(
        "[CAMERA ERROR] No image data received.");

      free(
        imageBuffer);

      imageBuffer =
        nullptr;


      if (
        cameraAttempt <
        MAX_CAMERA_ATTEMPTS) {

        delay(1000);

        continue;
      }


      return AI_ERROR;
    }


    Serial.print(
      "[CAMERA] Dynamic image downloaded: ");

    Serial.print(
      totalRead);

    Serial.println(
      " bytes");


    break;
  }


  // ===================================================
  // FINAL IMAGE CHECK
  // ===================================================

  if (
    imageBuffer == nullptr ||
    totalRead == 0) {

    Serial.println(
      "[AI ERROR] No valid camera image.");

    return AI_ERROR;
  }


  // ===================================================
  // JPEG SIGNATURE CHECK
  // ===================================================

  if (
    totalRead >= 2) {

    if (
      imageBuffer[0] != 0xFF ||
      imageBuffer[1] != 0xD8) {

      Serial.println(
        "[CAMERA ERROR] Image does not look like JPEG.");

      Serial.print(
        "[CAMERA] First bytes: ");

      Serial.print(
        imageBuffer[0],
        HEX);

      Serial.print(
        " ");

      Serial.println(
        imageBuffer[1],
        HEX);


      free(
        imageBuffer);

      return AI_ERROR;
    }


    Serial.println(
      "[CAMERA] JPEG signature OK.");
  }


  // ===================================================
  // SEND IMAGE TO AI SERVER
  // ===================================================

  const int MAX_AI_ATTEMPTS =
    3;


  for (
    int attempt = 1;
    attempt <= MAX_AI_ATTEMPTS;
    attempt++) {

    Serial.println();

    Serial.println(
      "--------------------------------");


    Serial.print(
      "[AI] Attempt ");

    Serial.print(
      attempt);

    Serial.print(
      "/");

    Serial.println(
      MAX_AI_ATTEMPTS);


    // =================================================
    // AI TCP CONNECTION
    // =================================================

    WiFiClient aiClient;


    aiClient.setTimeout(
      30000);


    Serial.print(
      "[AI] Connecting to ");

    Serial.print(
      AI_SERVER_IP);

    Serial.print(
      ":");

    Serial.println(
      AI_SERVER_PORT);


    if (
      !aiClient.connect(
        AI_SERVER_IP,
        AI_SERVER_PORT)) {

      Serial.println(
        "[AI ERROR] Cannot connect to Python server.");

      aiClient.stop();


      if (
        attempt <
        MAX_AI_ATTEMPTS) {

        Serial.println(
          "[AI] Retrying in 2 seconds...");

        delay(2000);

        continue;
      }


      free(
        imageBuffer);

      return AI_ERROR;
    }


    Serial.println(
      "[AI] Python server CONNECTED.");


    // =================================================
    // MULTIPART
    // =================================================

    const char* boundary =
      "----WEDENBoundary123456";


    String bodyStart =
      String("--") +
      boundary +
      "\r\n"
      "Content-Disposition: form-data; "
      "name=\"image\"; filename=\"camera.jpg\"\r\n"
      "Content-Type: image/jpeg\r\n"
      "\r\n";


    String bodyEnd =
      String("\r\n--") +
      boundary +
      "--\r\n";


    size_t totalBodySize =
      bodyStart.length() +
      totalRead +
      bodyEnd.length();


    // =================================================
    // HTTP REQUEST
    // =================================================

    aiClient.print(
      "POST ");

    aiClient.print(
      AI_SERVER_PATH);

    aiClient.println(
      " HTTP/1.1");


    aiClient.print(
      "Host: ");

    aiClient.print(
      AI_SERVER_IP);

    aiClient.print(
      ":");

    aiClient.println(
      AI_SERVER_PORT);


    aiClient.println(
      "Connection: close");


    aiClient.print(
      "Content-Type: multipart/form-data; boundary=");

    aiClient.println(
      boundary);


    aiClient.print(
      "Content-Length: ");

    aiClient.println(
      totalBodySize);


    aiClient.println();


    // =================================================
    // BODY HEADER
    // =================================================

    aiClient.print(
      bodyStart);


    // =================================================
    // JPEG UPLOAD
    // =================================================

    Serial.print(
      "[AI] Uploading JPEG: ");

    Serial.print(
      totalRead);

    Serial.println(
      " bytes...");


    size_t sentBytes = 0;


    bool uploadOK =
      true;


    unsigned long uploadStart =
      millis();


    while (
      sentBytes <
      totalRead &&
      millis() -
      uploadStart <
      30000) {

      size_t remaining =
        totalRead -
        sentBytes;


      size_t chunkSize =
        remaining;


      if (
        chunkSize >
        2048) {

        chunkSize =
          2048;
      }


      size_t written =
        aiClient.write(
          imageBuffer +
          sentBytes,
          chunkSize);


      if (
        written == 0) {

        uploadOK =
          false;

        break;
      }


      sentBytes +=
        written;


      delay(2);

      yield();
    }


    if (
      sentBytes !=
      totalRead) {

      uploadOK =
        false;
    }


    if (!uploadOK) {

      Serial.print(
        "[AI ERROR] Upload failed. Sent ");

      Serial.print(
        sentBytes);

      Serial.print(
        " / ");

      Serial.print(
        totalRead);

      Serial.println(
        " bytes.");


      aiClient.stop();


      if (
        attempt <
        MAX_AI_ATTEMPTS) {

        Serial.println(
          "[AI] Retrying in 2 seconds...");

        delay(2000);

        continue;
      }


      free(
        imageBuffer);

      return AI_ERROR;
    }


    // =================================================
    // MULTIPART END
    // =================================================

    aiClient.print(
      bodyEnd);


    Serial.println(
      "[AI] JPEG upload complete.");


    Serial.println(
      "[AI] Waiting for Python response...");


    // =================================================
    // RESPONSE
    // =================================================

    String response = "";


    unsigned long responseStart =
      millis();


    while (
      millis() -
      responseStart <
      60000) {

      while (
        aiClient.available()) {

        char c =
          aiClient.read();


        if (
          response.length() <
          8192) {

          response +=
            c;
        }
      }


      if (
        !aiClient.connected() &&
        !aiClient.available()) {

        break;
      }


      delay(5);

      yield();
    }


    aiClient.stop();


    // =================================================
    // RAW RESPONSE
    // =================================================

    Serial.println();

    Serial.println(
      "[AI] =================================");

    Serial.println(
      "[AI] PYTHON SERVER RESPONSE:");

    Serial.println(
      response);

    Serial.println(
      "[AI] =================================");


    // =================================================
    // HTTP STATUS
    // =================================================

    int httpStatusCode =
      -1;


    int statusPos =
      response.indexOf(
        "HTTP/1.1 ");


    if (
      statusPos < 0) {

      statusPos =
        response.indexOf(
          "HTTP/1.0 ");
    }


    if (
      statusPos >= 0 &&
      response.length() >=
      statusPos + 12) {

      String code =
        response.substring(
          statusPos + 9,
          statusPos + 12);


      httpStatusCode =
        code.toInt();
    }


    Serial.print(
      "[AI] HTTP STATUS: ");

    Serial.println(
      httpStatusCode);


    // =================================================
    // HTTP 200
    // =================================================

    if (
      httpStatusCode == 200) {

      int bodyPosition =
        response.indexOf(
          "\r\n\r\n");


      String result =
        "";


      if (
        bodyPosition >= 0) {

        result =
          response.substring(
            bodyPosition + 4);
      }

      else {

        result =
          response;
      }


      result.trim();


      // =================================================
      // NORMALIZE RESPONSE
      // =================================================

      String upperResult =
        result;

      upperResult.toUpperCase();


      Serial.print(
        "[AI] RESULT BODY: ");

      Serial.println(
        result);


      Serial.print(
        "[AI] NORMALIZED: ");

      Serial.println(
        upperResult);


      // =================================================
      // NO FIRE FIRST
      // =================================================

      if (
        upperResult.indexOf(
          "NO_FIRE") >= 0) {

        Serial.println();

        Serial.println(
          "[AI] VERIFICATION: NO FIRE");


        free(
          imageBuffer);

        return AI_NO_FIRE;
      }


      // =================================================
      // FIRE
      // =================================================

      if (
        upperResult.indexOf(
          "FIRE") >= 0) {

        Serial.println();

        Serial.println(
          "[AI] VERIFICATION: FIRE");


        free(
          imageBuffer);

        return AI_FIRE;
      }


      // =================================================
      // UNKNOWN
      // =================================================

      Serial.println(
        "[AI ERROR] Unknown AI response.");

      Serial.println(
        "[AI ERROR] Expected FIRE or NO_FIRE.");


      if (
        attempt <
        MAX_AI_ATTEMPTS) {

        Serial.println(
          "[AI] Retrying...");

        delay(2000);

        continue;
      }


      free(
        imageBuffer);

      return AI_ERROR;
    }


    // =================================================
    // SERVER ERROR
    // =================================================

    Serial.print(
      "[AI ERROR] Python HTTP status: ");

    Serial.println(
      httpStatusCode);


    if (
      attempt <
      MAX_AI_ATTEMPTS) {

      Serial.println(
        "[AI] Retrying in 2 seconds...");

      delay(2000);

      continue;
    }


    free(
      imageBuffer);

    return AI_ERROR;
  }


  // ===================================================
  // FINAL ERROR
  // ===================================================

  free(
    imageBuffer);


  Serial.println();

  Serial.println(
    "================================");

  Serial.println(
    "[AI ERROR] AI VERIFICATION FAILED");

  Serial.println(
    "================================");


  return AI_ERROR;
}


// =====================================================
// SEND SMS
// =====================================================

bool sendSMS() {

  Serial.println();

  Serial.println(
    "================================");

  Serial.println(
    "       SENDING SMS ALERT");

  Serial.println(
    "================================");


  while (
    A7670E.available()) {

    A7670E.read();
  }


  Serial.println(
    ">> AT");


  A7670E.println(
    "AT");


  printA7670Response(
    1000);


  Serial.println(
    ">> AT+CMGF=1");


  A7670E.println(
    "AT+CMGF=1");


  printA7670Response(
    1000);


  A7670E.print(
    "AT+CMGS=\"");


  A7670E.print(
    PHONE_NUMBER);


  A7670E.println(
    "\"");


  delayWithFireBlink(
    1500);


  while (
    A7670E.available()) {

    Serial.write(
      A7670E.read());
  }


  String message =
    "WILDFIRE ALERT! "
    "Fire detected by MQ2 and TMP36. "
    "ESP32-CAM AI verification confirmed FIRE. "
    "Please respond immediately.";


  A7670E.print(
    message);


  A7670E.write(
    26);


  String smsResponse =
    "";


  unsigned long startTime =
    millis();


  while (
    millis() -
    startTime <
    15000) {

    updateFireLEDBlink();


    while (
      A7670E.available()) {

      char c =
        A7670E.read();


      Serial.write(
        c);


      smsResponse +=
        c;
    }


    delay(10);
  }


  if (
    smsResponse.indexOf(
      "+CMGS:") >= 0 &&
    smsResponse.indexOf(
      "OK") >= 0) {

    Serial.println(
      "SMS SEND: SUCCESS");

    return true;
  }


  Serial.println(
    "SMS SEND: FAILED");

  return false;
}


