        A7670E.read();


      Serial.write(
        c);
    }


    delay(10);
  }


  Serial.println();
}


// =====================================================
// WIFI CONNECTION
// =====================================================

void connectWiFi() {

  Serial.println();

  Serial.println(
    "================================");

  Serial.println(
    "       WIFI CONNECTION");

  Serial.println(
    "================================");


  WiFi.mode(
    WIFI_STA);


  WiFi.setSleep(
    false);


  WiFi.begin(
    WIFI_SSID,
    WIFI_PASSWORD);


  int attempts =
    0;


  while (
    WiFi.status() !=
    WL_CONNECTED &&
    attempts < 30) {

    delay(500);

    Serial.print(
      ".");

    attempts++;
  }


  Serial.println();


  if (
    WiFi.status() ==
    WL_CONNECTED) {

    Serial.println(
      "WiFi: CONNECTED");


    Serial.print(
      "Main ESP32 IP: ");

    Serial.println(
      WiFi.localIP());


    Serial.print(
      "ESP32-CAM IP: ");

    Serial.println(
      CAMERA_IP);


    Serial.print(
      "Python AI Server: ");

    Serial.println(
      AI_VERIFY_URL);
  }

  else {

    Serial.println(
      "WiFi: CONNECTION FAILED");
  }
}
