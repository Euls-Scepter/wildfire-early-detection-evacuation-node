// =====================================================
// CAPTURE ENDPOINT
// =====================================================
//
// URL:
//
// /capture
//
// Returns:
// JPEG image
//
// =====================================================

void handleCapture() {

  Serial.println();
  Serial.println("================================");
  Serial.println("CAMERA CAPTURE REQUEST");
  Serial.println("================================");

  Serial.println("Capturing image...");


  camera_fb_t *fb =
    esp_camera_fb_get();


  if (!fb) {

    Serial.println(
      "ERROR: Camera capture failed.");

    server.send(
      500,
      "text/plain",
      "CAMERA_CAPTURE_FAILED");

    return;
  }


  Serial.print(
    "Image captured: ");

  Serial.print(
    fb->len);

  Serial.println(
    " bytes");


  // Send JPEG to requester

  WiFiClient client =
    server.client();


  server.setContentLength(
    fb->len);

  server.send(
    200,
    "image/jpeg");


  client.write(
    fb->buf,
    fb->len);


  // Return frame buffer

  esp_camera_fb_return(
    fb);


  Serial.println(
    "JPEG sent successfully.");

  Serial.println(
    "================================");
}


// =====================================================
// ROOT PAGE
